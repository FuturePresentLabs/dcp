{
  "id": "dcp",
  "project": "fpl",
  "defaultHostname": "dcp.sites.fpl.dev",
  "githubRepo": "FuturePresentLabs/dcp",
  "gitUrl": "https://github.com/FuturePresentLabs/dcp.git",
  "productionBranch": "main",
  "domain": "dcp.fpl.dev",
  "path": "/",
  "autoPromoteProduction": false,
  "installCommand": "npm exec --yes --package=node@$NODE_VERSION -- node \"$(command -v npm)\" ci --include=optional",
  "buildCommand": "npm exec --yes --package=node@$NODE_VERSION -- node \"$(command -v npm)\" run build && node --test tests/static-export.test.mjs",
  "publishDir": "dist/client",
  "framework": "static",
  "env": { "FAB_STATIC_EXPORT": "1", "NODE_VERSION": "22.23.3" }
}
