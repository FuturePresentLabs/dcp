{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisions.directory/schemas/v0.1/parameter-round.json",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "request_id", "action_id", "expected_catalog_revision", "expected_state_revision", "arguments", "fields"],
  "properties": {
    "profile": {"const": "https://decisions.directory/profiles/parameter-rounds/0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "expected_catalog_revision": {"type": "string", "minLength": 1},
    "expected_state_revision": {"type": "string", "minLength": 1},
    "arguments": {"type": "object"},
    "fields": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unit", "reference_frame", "minimum", "maximum", "candidates", "allow_bounded_estimate"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "reference_frame": {"type": "string", "minLength": 1},
        "minimum": {"type": "number"}, "maximum": {"type": "number"},
        "allow_bounded_estimate": {"type": "boolean"},
        "candidates": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "value", "source"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "value": {"type": "number"},
            "source": {"enum": ["datum", "named_parameter", "prompt_literal"]}
          }
        }}
      }
    }}
  }
}
