{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisions.directory/schemas/v0.1/directory-entry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "source", "discovery", "claims", "contact"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "format": "uri" },
    "discovery": { "type": "string", "format": "uri" },
    "contact": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "profile", "status", "fixture", "conformance_command"],
        "properties": {
          "version": { "$ref": "common.json#/$defs/version" },
          "profile": { "enum": ["catalog-provider", "executor", "streaming", "directory-listed"] },
          "status": { "enum": ["self-tested", "verified"] },
          "fixture": { "type": "string", "format": "uri" },
          "conformance_command": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
