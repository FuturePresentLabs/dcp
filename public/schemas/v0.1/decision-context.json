{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisions.directory/schemas/v0.1/decision-context.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "inputs"],
  "properties": {
    "schema": {"const": "dcp.decision-context.v1"},
    "source_revision": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "schema", "required", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {"enum": ["structured", "geometry", "text", "image", "pdf"]},
        "schema": {"type": "string", "minLength": 1, "maxLength": 256},
        "required": {"type": "boolean"},
        "units": {"type": "string", "minLength": 1, "maxLength": 128},
        "frame": {"type": "string", "minLength": 1, "maxLength": 128},
        "source": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["type", "value"],
           "properties": {"type": {"const": "inline"}, "value": {"not": {"type": "null"}}}},
          {"type": "object", "additionalProperties": false,
           "required": ["type", "uri", "sha256", "media_type", "byte_length"],
           "properties": {"type": {"const": "artifact"},
             "uri": {"type": "string", "maxLength": 2048, "pattern": "^(https://|urn:)\\S+$"},
             "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
             "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
             "byte_length": {"type": "integer", "minimum": 1}}}
        ]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "geometry"}}}, "then": {"required": ["units", "frame"]}},
        {"if": {"properties": {"kind": {"enum": ["image", "pdf"]}}},
         "then": {"properties": {"source": {"type":"object", "properties": {"type": {"const": "artifact"}}}}}},
        {"if": {"properties": {"kind": {"const": "pdf"}}},
         "then": {"properties": {"source": {"type":"object", "properties": {"media_type": {"const": "application/pdf"}}}}}},
        {"if": {"properties": {"kind": {"const": "image"}}},
         "then": {"properties": {"source": {"type":"object", "properties": {"media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]}}}}}}
      ]
    }}
  }
}
