{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisions.directory/schemas/v0.1/catalog.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["dcp_version", "provider", "catalog_revision", "state_revision", "observed_at", "actions"],
  "properties": {
    "dcp_version": { "$ref": "common.json#/$defs/version" },
    "provider": { "$ref": "common.json#/$defs/provider" },
    "catalog_revision": { "$ref": "common.json#/$defs/revision" },
    "state_revision": { "$ref": "common.json#/$defs/revision" },
    "observed_at": { "$ref": "common.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.json#/$defs/timestamp" },
    "state": { "type": "object" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "title", "description", "input_schema", "phases", "safety", "availability"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/id" },
          "domain": { "$ref": "common.json#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "input_schema": {
            "type": "object",
            "required": ["$schema", "type"],
            "properties": {
              "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
              "type": { "const": "object" }
            }
          },
          "phases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["prepare", "commit", "cancel"] } },
          "safety": {
            "type": "object",
            "additionalProperties": false,
            "required": ["idempotent", "reversible", "requires_final", "confirmation_required"],
            "properties": {
              "idempotent": { "type": "boolean" },
              "reversible": { "type": "boolean" },
              "requires_final": { "type": "boolean" },
              "confirmation_required": { "type": "boolean" }
            }
          },
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["available"],
            "properties": {
              "available": { "type": "boolean" },
              "reason_code": { "$ref": "common.json#/$defs/id" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "allOf": [{ "if": { "properties": { "available": { "const": false } }, "required": ["available"] }, "then": { "required": ["reason_code"] } }]
          }
        }
      }
    },
    "tree": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "action_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.json#/$defs/id" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
